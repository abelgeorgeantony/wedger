<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wedger</title>


    <link rel="stylesheet" href="./assets/css/base.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pirata+One&display=swap" rel="stylesheet">
</head>

<body>
    <div id="loading-overlay">
        <div class="spinner"></div>
        <div id="loading-details">Initializing runtime...</div>
    </div>

    <aside id="sidebar-left">
        <header>
            <h2 id="sidebar-left-logo">Wedger</h2>
            <button id="slide-btn">
                <img src="/assets/icons/hide-sidebar.svg" alt="Hide the sidebar">
            </button>
        </header>
        <main>
            <div>
                <div>
                    <button id="journals-dropdown-btn">
                        Journals
                        <img src="/assets/icons/dropdown.svg" alt="Drop down the journal list">
                    </button>
                    <button id="new-file-btn">
                        <img src="/assets/icons/new-file.svg" alt="Create a new file">
                    </button>
                    <button id="import-file-btn">
                        <img src="/assets/icons/import-file.svg" alt="Import a file">
                    </button>
                </div>
                <ul>
                    <li>filename.journal</li>
                </ul>
            </div>
            <button>Timeline</button>
            <button>Reports Output</button>
        </main>
        <footer>
            <!-- Unified Google Login/Sync Button -->
            <button type="button" id="google-login-btn" class="secondary"
                style="display: flex; align-items: center; gap: 6px; padding: 4px 10px; border: 1px solid var(--rule); border-radius: 4px; background: var(--panel);">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18">
                    <path fill="#4285F4"
                        d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z" />
                    <path fill="#34A853"
                        d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.11 0-5.74-2.1-6.68-4.92H1.2v3.15C3.18 21.31 7.27 24 12 24z" />
                    <path fill="#FBBC05"
                        d="M5.32 14.28c-.24-.72-.38-1.5-.38-2.28s.14-1.56.38-2.28V6.57H1.2C.43 8.12 0 9.99 0 12s.43 3.88 1.2 5.43l4.12-3.15z" />
                    <path fill="#EA4335"
                        d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.27 0 3.18 2.69 1.2 6.57l4.12 3.15c.94-2.82 3.57-4.97 6.68-4.97z" />
                </svg>
                Sign in with google
            </button>
            <!-- Authenticated User Profile Trigger Button -->
            <div id="user-profile-container" style="display: none; position: relative; align-items: center;">
                <button type="button" id="user-avatar-btn" aria-label="User profile menu">
                    <img id="user-avatar" src="" alt="Profile" referrerpolicy="no-referrer" />
                </button>
            </div>
            <button id="settings-btn">
                <img src="/assets/icons/settings.svg" alt="Open settings">
            </button>
        </footer>
    </aside>

    <!-- drag handle -->
    <div id="resizer" role="separator" aria-orientation="vertical" aria-label="Resize sidebar" aria-valuemin="15"
        aria-valuemax="40" tabindex="0">
    </div>

    <main>
        <header>
            <div id="file-tab-bar">
                <button id="file-tab-options-btn">
                    <img src="/assets/icons/3-vertical-dots.svg" alt="Open options of the file tab area">
                </button>
            </div>
            <div id="file-menu-bar">
                <!--
                    MENU BAR THAT CHANGES FOR EACH FILE
                    JS should inject the menu here for each file
                    according to the needs
                -->
            </div>
        </header>
        <main>
            <!-- FILE DISPLAY -->
        </main>
    </main>

    <script src="./assets/js/init.js" defer></script>
    <script src="./assets/js/ui/helpers.js" defer></script>
    <!---<script type="module" src="./assets/js/state.js"></script>
    <script type="module" src="./assets/js/app.js"></script>--->
</body>
<script>
    document.getElementById("loading-overlay").style.display = "none";
</script>

</html>